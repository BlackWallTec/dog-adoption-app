# ── Servidor ─────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Supabase ─────────────────────────────
SUPABASE_URL=https://supabase.co
SUPABASE_ANON_KEY=
# Solo backend. Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Correo compartido por CFDI y Perfiles ─────────────────
RESEND_API_KEY=
MAIL_FROM=

# ── Auth ─────────────────────────────────
# Generado automáticamente con: openssl rand -base64 48
JWT_SECRET=
# Opcional: separa la firma de códigos del secreto de JWT. Si falta, usa JWT_SECRET.
EMAIL_CODE_SECRET=

SIGNUP_DATABASE_URL=

# Correo Android. Habilitar como "supabase" sólo después de aplicar la migración.
CORREO_MOVIL_MODO=desactivado

# ── Rate Limiter Keys ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gmail para la demo sin dominio: MAIL_TRANSPORT=gmail y contraseña de aplicación.
MAIL_TRANSPORT=resend
SMTP_USER=
SMTP_PASS=
