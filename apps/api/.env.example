# ── Servidor ─────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Supabase ─────────────────────────────
# SUPABASE_URL
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# AKA. SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
# AKA. SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ─────────────────────────────────
# Genéralo con: openssl rand -base64 48
JWT_SECRET=
SIGNUP_DATABASE_URL=

# ── Correo de perfiles (MVP de desarrollo) ──
# Mantener desactivado hasta configurar la persistencia para producción.
PERFILES_CORREO_MODO=desactivado
WEB_PUBLIC_URL=http://localhost:5173
# inbox: bandeja local de pruebas. brevo: entrega mediante la API de Brevo.
EMAIL_TRANSPORT=inbox
BREVO_API_KEY=
# Dirección de un remitente verificado en Brevo (sin el nombre ni < >).
MAIL_FROM=
MAIL_FROM_NAME=Qariño Animal
