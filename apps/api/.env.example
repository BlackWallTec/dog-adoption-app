# ── Servidor ─────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Supabase ─────────────────────────────
SUPABASE_URL=https://supabase.co
SUPABASE_ANON_KEY=
# Solo backend. Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Envío de CFDI por correo ─────────────────
RESEND_API_KEY=
MAIL_FROM=

# ── Auth ─────────────────────────────────
# Generado automáticamente con: openssl rand -base64 48
JWT_SECRET=

SIGNUP_DATABASE_URL=

# Correo Android
CORREO_MOVIL_MODO=desactivado

# ── Rate Limiter Keys ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
