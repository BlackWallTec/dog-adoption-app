#!/bin/sh
set -e
msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Allow merge/revert auto-generated messages
case "$first_line" in
  Merge*|Revert*|"") exit 0 ;;
esac

if ! echo "$first_line" | grep -qE '^(feat|fix|docs|style|refactor|test|build|ci|chore|revert)(\([a-z]+\))?!?: .+'; then
  echo ""
  echo "ERROR: Commit message must follow Conventional Commits."
  echo "Format: type(scope): description"
  echo "Example: feat(catalogo): add dog filters"
  echo ""
  exit 1
fi