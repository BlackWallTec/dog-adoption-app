#!/bin/sh
set -e

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED")

case "$branch" in
  main|master|develop) ;;
  *)
    if ! printf '%s' "$branch" | grep -qE '^(feature|feat|bugfix|fix|hotfix|release|chore|ai|copilot|cursor|claude|codex)/[a-z0-9]+([.-][a-z0-9]+)*$'; then
      echo ""
      echo "ERROR: Branch '$branch' does not match the naming convention."
      echo "Rename with: git branch -m <type>/<short-description>"
      echo ""
      exit 1
    fi
    ;;
esac

vp staged